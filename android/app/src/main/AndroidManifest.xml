<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Not required: a phone without Bluetooth can still reach a laptop over Wi-Fi or USB tethering. -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Finding laptops on the Wi-Fi and over USB tethering. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- Android 17 blocks an app targeting API 37 from the local network until this runtime permission (Nearby devices group) is granted. -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <!-- For one thing only: asking GitHub which release is newest, and fetching it. See update/Updates.kt. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- To install that release over this app. The second lets Android 12 and later skip its question. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

  <application
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Edgepad">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <receiver
      android:name=".update.Installer$StatusReceiver"
      android:exported="false" />

    <!-- Serves the one image a laptop sent to the clipboard. The app a user pastes into is granted that one URI. -->
    <provider
      android:name=".link.ClipProvider"
      android:authorities="${applicationId}.clip"
      android:exported="false"
      android:grantUriPermissions="true" />

  </application>

</manifest>
