<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- For one thing only: asking GitHub which release is newest, and fetching it. See update/Updates.kt. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- To install that release over this app. The second lets Android 12 and later skip its question. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

  <application
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Edgepad">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <receiver
      android:name=".update.Installer$StatusReceiver"
      android:exported="false" />

  </application>

</manifest>
