<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Accessibility actions on the control surface. Stable ids: View.generateViewId() starts at 1 and
       collides with the platform's own action ids. -->
  <item name="action_play_pause" type="id" />
  <item name="action_next_track" type="id" />
  <item name="action_previous_track" type="id" />
  <item name="action_open_settings" type="id" />
  <item name="action_controls" type="id" />
  <item name="action_type_text" type="id" />
  <item name="action_pad_lock" type="id" />
  <item name="action_volume_up" type="id" />
  <item name="action_volume_down" type="id" />
  <item name="action_brightness_up" type="id" />
  <item name="action_brightness_down" type="id" />
  <item name="action_mute" type="id" />
  <item name="action_batteries" type="id" />
  <!-- The macro deck in edit mode: a tile moves one place earlier or later, for those who cannot drag. -->
  <item name="action_move_earlier" type="id" />
  <item name="action_move_later" type="id" />
  <!-- The two layout editors: a control or piece moves one grid cell, for those who cannot drag (ANDU-6). -->
  <item name="action_move_left" type="id" />
  <item name="action_move_right" type="id" />
  <item name="action_move_up" type="id" />
  <item name="action_move_down" type="id" />
  <!-- The widget layout editor: a widget's size picker, for those who cannot long press. -->
  <item name="action_resize" type="id" />
  <!-- The Guide's frame: saved view state is keyed by id, and the Guide keeps its step there. -->
  <item name="guide" type="id" />
</resources>
