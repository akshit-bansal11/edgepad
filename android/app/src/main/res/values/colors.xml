<?xml version="1.0" encoding="utf-8"?>
<resources>
  <color name="ic_launcher_background">#1A1A1A</color>
  <!-- Edgepad 2.0, the light set; values-night/colors.xml holds the dark one. iOS-style grouped surfaces:
       [panel] is the ground, [card] the grouped cell on it. One accent, used for what is selected, on,
       live or the main action. Every text pair was computed at 4.5:1 or better: ink on panel 16.2:1, dim
       on panel 4.6:1 and on card 5.1:1, accent on card 5.3:1 and on panel 4.8:1, white on accent 5.3:1,
       danger on faint 4.6:1. -->
  <color name="panel">#F2F3F7</color>
  <color name="card">#FFFFFF</color>
  <color name="line">#E3E5EA</color>
  <color name="faint">#EBEDF2</color>
  <color name="ink">#16171A</color>
  <color name="dim">#6B6E76</color>
  <color name="accent">#0068D6</color>
  <color name="on_accent">#FFFFFF</color>
  <color name="accent_soft">#E6F0FC</color>
  <color name="off">#E3E5EA</color>
  <color name="danger">#D70015</color>
</resources>
