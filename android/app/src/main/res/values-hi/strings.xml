  <string name="address_invalid">यह पता सही नहीं है। होस्ट नाम या IP पता लिखें; पोर्ट 47321 न हो तो पोर्ट भी लिखें।</string>
  <string name="address_no_laptop">उस पते पर Edgepad वाले किसी लैपटॉप ने जवाब नहीं दिया।</string>
  <string name="usb_tethering">USB टेदरिंग</string>
  <string name="local_network_needed">आपके वाई-फ़ाई और USB पर लैपटॉप ढूंढने के लिए Edgepad को \"आस-पास के डिवाइस\" की अनुमति चाहिए।</string>
  <string name="allow_local_network">\"आस-पास के डिवाइस\" की अनुमति दें</string>
  <string name="open_controls">कंट्रोल खोलें</string>
  <string name="open_controls_hint">कंट्रोल खोलने के लिए पहले लैपटॉप से कनेक्ट करें।</string>
  <string name="open_bluetooth_settings">ब्लूटूथ सेटिंग्स</string>
  <string name="refresh">सूची रीफ़्रेश करें</string>
  <string name="bluetooth_off">कोई लैपटॉप नहीं मिला। ब्लूटूथ चालू करें और अपना लैपटॉप पेयर करें। वाई-फ़ाई या USB के लिए लैपटॉप पर Edgepad खोलें और उसके मेन्यू में \"वाई-फ़ाई और USB कनेक्शन\" चालू करें; USB के लिए यहां USB टेदरिंग भी चालू करें।</string>
  <string name="usb_cable_tether_off">केबल जुड़ी है। यहां USB टेदरिंग चालू करें, और लैपटॉप पर Edgepad के मेन्यू में \"वाई-फ़ाई और USB कनेक्शन\" चालू करें।</string>
  <string name="status_no_wifi">वाई-फ़ाई से कनेक्ट नहीं है।</string>
  <string name="status_searched_wifi">आपके वाई-फ़ाई नेटवर्क में खोजा, पर किसी लैपटॉप ने जवाब नहीं दिया।</string>
  <string name="status_searched_usb">USB टेदरिंग में खोजा, पर किसी लैपटॉप ने जवाब नहीं दिया।</string>
  <string name="permission_needed">आपके लैपटॉप तक पहुंचने के लिए Edgepad को \"आस-पास के डिवाइस\" की अनुमति चाहिए।</string>
  <string name="permission_reason">आपका लैपटॉप ढूंढने के लिए Edgepad \"आस-पास के डिवाइस\" की अनुमति मांगता है।</string>
  <string name="local_network_reason">आपके वाई-फ़ाई और USB पर लैपटॉप ढूंढने के लिए Edgepad \"आस-पास के डिवाइस\" की अनुमति मांगता है और आपके नेटवर्क के पते जांचता है। \"पता डालकर जोड़ें\" से इस खोज की ज़रूरत नहीं पड़ती।</string>
  <string name="no_paired">कोई लैपटॉप नहीं मिला। अपने लैपटॉप पर Edgepad खोलें और उसे ब्लूटूथ सेटिंग्स में पेयर करें। वाई-फ़ाई या USB के लिए लैपटॉप पर Edgepad के मेन्यू में \"वाई-फ़ाई और USB कनेक्शन\" चालू करें; USB के लिए यहां USB टेदरिंग भी चालू करें।</string>
  <string name="no_laptop_paired">इस फ़ोन से पेयर किए गए किसी भी डिवाइस ने खुद को कंप्यूटर नहीं बताया। अगर आपका लैपटॉप पेयर है, तो सभी डिवाइस दिखाएं।</string>
  <plurals name="show_all_paired">
    <item quantity="one">सभी पेयर किए डिवाइस दिखाएं (%1$d और)</item>
    <item quantity="other">सभी पेयर किए डिवाइस दिखाएं (%1$d और)</item>
