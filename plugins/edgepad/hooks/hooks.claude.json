{
  "modules": ["./relay.ts"],
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/edgepad-hook.mjs", "claude", "perm"], "timeout": 120 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/edgepad-hook.mjs", "claude", "session"], "timeout": 5 },
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/scan-claude.mjs"], "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/edgepad-hook.mjs", "claude", "session"], "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/edgepad-hook.mjs", "claude", "session"], "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/edgepad-hook.mjs", "claude", "session"], "timeout": 5 },
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/scan-claude.mjs"], "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__ROOT__/scripts/edgepad-hook.mjs", "claude", "session"], "timeout": 5 }
        ]
      }
    ]
  }
}
