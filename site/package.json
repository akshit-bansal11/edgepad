{
  "name": "edgepad-site",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for Edgepad.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "biome format --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write . && eslint . && tsc --noEmit",
    "check:ci": "biome ci . && eslint . && tsc --noEmit",
    "preview": "npx --yes serve out"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
