<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Plain net10.0, no OS suffix: the laptop apps for Windows and Linux both reference this, and Linux CI builds it. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Edgepad</RootNamespace>
    <AssemblyName>Edgepad.Core</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <!-- A laptop app's `dotnet publish -r <rid> -p:PublishSingleFile=true` hands both to this project too, so
         its locked-mode restore needs those runtimes and the single-file analyzer's ILLink package in this lock
         file as well. Named here for the same reason the Windows project names its own. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- The words the laptop apps share, in English; CoreStrings.<culture>.resx beside it holds the translations. MSBuild
         writes the typed accessor (Edgepad.CoreStrings) into obj/ at build, as the Windows project does for its own. -->
    <EmbeddedResource Update="CoreStrings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreStrings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Edgepad</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreStrings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Every type moved here stays internal, as it was in the Windows project. -->
    <InternalsVisibleTo Include="Edgepad" />
    <InternalsVisibleTo Include="Edgepad.Tests" />
    <InternalsVisibleTo Include="Edgepad.Core.Tests" />
    <InternalsVisibleTo Include="Edgepad.Linux" />
    <InternalsVisibleTo Include="Edgepad.Linux.Tests" />
  </ItemGroup>

</Project>
