# The deploy is built from the repository root, because site/lib/protocol.ts reads
# ../protocol/*.txt at build time. Everything the build does not touch is excluded so
# the upload stays small: the two apps' source and build output, and the untracked
# workspace the demo video is rendered in. The finished demo the page plays lives in
# site/public and is uploaded with it.
/android
/windows
/assets
/brag-output
/scripts
/docs
/.github

