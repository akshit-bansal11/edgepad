<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection in this TFM is what exposes the WinRT Bluetooth RFCOMM APIs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Edgepad</RootNamespace>
    <AssemblyName>Edgepad</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Edgepad mark, the same drawing as the Android launcher icon; the tray reads it back from the exe. -->
    <ApplicationIcon>edgepad.ico</ApplicationIcon>
    <!-- LibraryImport generates unsafe marshalling code for the SendInput P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Edgepad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Audio: speaker and microphone level and mute. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- WMI: the built-in panel's brightness. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
