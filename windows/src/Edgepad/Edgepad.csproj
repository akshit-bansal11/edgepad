<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection in this TFM is what exposes the WinRT Bluetooth RFCOMM APIs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Edgepad</RootNamespace>
    <AssemblyName>Edgepad</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Edgepad mark, the same drawing as the Android launcher icon; the tray reads it back from the exe. -->
    <ApplicationIcon>edgepad.ico</ApplicationIcon>
    <!-- LibraryImport generates unsafe marshalling code for the SendInput P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Edgepad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lato, the design's face, carried inside the exe so a single-file release needs nothing installed. Ui/Theme
         loads the three by these names. The OFL asks that its text travel with the fonts, so it is embedded too. -->
    <EmbeddedResource Include="Fonts\Lato-Regular.ttf" LogicalName="Edgepad.Fonts.Lato-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Lato-Bold.ttf" LogicalName="Edgepad.Fonts.Lato-Bold.ttf" />
    <EmbeddedResource Include="Fonts\Lato-Black.ttf" LogicalName="Edgepad.Fonts.Lato-Black.ttf" />
    <EmbeddedResource Include="Fonts\OFL.txt" LogicalName="Edgepad.Fonts.OFL.txt" />
    <!-- Ui/Icons draws Lucide's paths, and Lucide's ISC licence asks the same of them. -->
    <EmbeddedResource Include="Ui\Lucide-LICENSE.txt" LogicalName="Edgepad.Ui.Lucide-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Audio: speaker and microphone level and mute. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- WMI: the built-in panel's brightness. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
    <!-- ViGEmBus: the virtual Xbox controller the phone's gamepad drives. -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

</Project>
